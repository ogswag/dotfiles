# Local Pure compositions. Vendored Pure 1.28.3 lives in vendor/pure.
typeset -g PURE_PRESET_FILE=${PURE_PRESET_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/zsh/pure-preset}

if [[ -z ${_PURE_LOCAL_LOADED:-} ]]; then
    typeset -g _PURE_LOCAL_LOADED=1
    typeset -U fpath
    fpath=("${${(%):-%N}:A:h}/vendor/pure" $fpath)
    source "${fpath[1]}/pure.zsh"
    functions -c prompt_pure_preprompt_render pure_preset_upstream_render
fi

# Pure prints a spacer line in precmd. Keep it for the two-line preset only.
prompt_pure_preprompt_render() {
    if [[ $1 == precmd && $PURE_PRESET != pure ]]; then
        pure_preset_upstream_render
    else
        pure_preset_upstream_render "$@"
    fi
}

pure_preset_apply() {
    emulate -L zsh
    setopt promptsubst promptpercent
    local preset=$1
    case $preset in
        current|pure|compact|minimal) ;;
        *) print -u2 -- "Unknown Pure preset: $preset"; return 1 ;;
    esac

    # Reset Pure styles so switching is reversible in the current shell.
    zstyle ':prompt:pure:git' show yes
    zstyle ':prompt:pure:environment:node_version' show no
    zstyle ':prompt:pure:git:stash' show no
    zstyle ':prompt:pure:path:separator' dim no
    if [[ $preset == current ]]; then
        PURE_PROMPT_SYMBOL='$'
        zstyle ':prompt:pure:git:branch' color 10
        zstyle ':prompt:pure:git:dirty' color 13
        zstyle ':prompt:pure:prompt:success' color 5
        zstyle ':prompt:pure:prompt:error' color 9
        zstyle ':prompt:pure:host' color 2
        zstyle ':prompt:pure:user' color 2
        zstyle ':prompt:pure:virtualenv' color 3
    else
        PURE_PROMPT_SYMBOL='❯'
        zstyle ':prompt:pure:git:branch' color 242
        zstyle ':prompt:pure:git:dirty' color 218
        zstyle ':prompt:pure:prompt:success' color magenta
        zstyle ':prompt:pure:prompt:error' color red
        zstyle ':prompt:pure:host' color 242
        zstyle ':prompt:pure:user' color 242
        zstyle ':prompt:pure:virtualenv' color 242
    fi
    [[ $preset == minimal ]] && zstyle ':prompt:pure:git' show no
    [[ $preset == pure ]] && zstyle ':prompt:pure:environment:node_version' show yes

    prompt_pure_set_colors
    prompt_pure_reset_prompt_symbol
    local indicator='%(?.%F{$prompt_pure_colors[prompt:success]}.%F{$prompt_pure_colors[prompt:error]})${prompt_pure_state[prompt]}%f '
    local path='${${prompt_pure_path_separator_dimmed:+$(prompt_pure_render_dimmed_path)}:-${prompt_pure_path_segment}}'
    local identity='%(13V.%F{$prompt_pure_colors['"${prompt_pure_state[user_color]:-user}"']}%n%f'
    (( prompt_pure_state[show_host] )) && identity+='%F{$prompt_pure_colors[host]}@%m%f'
    identity+=' .)'
    local jobs='%(12V.%F{$prompt_pure_colors[suspended_jobs]}%12v%f .)'
    local git_branch='%(14V. %F{${prompt_pure_git_branch_color}}%14v%(15V.%F{$prompt_pure_colors[git:dirty]}%15v.)%f.)'
    local git_action='%(16V. %F{$prompt_pure_colors[git:action]}%16v%f.)'
    local git_arrows='%(17V. %F{$prompt_pure_colors[git:arrow]}%17v%f.)'
    local git_stash='%(18V. %F{$prompt_pure_colors[git:stash]}%18v%f.)'
    local node='%(21V. %F{$prompt_pure_colors[node_version]}%21v%f.)'
    local time='%(19V. %F{$prompt_pure_colors[execution_time]}%19v%f.)'
    local env_left='%(20V.%F{$prompt_pure_colors[virtualenv]}%20v%f .)'
    local env_right='%(20V. %F{$prompt_pure_colors[virtualenv]}(%20v)%f.)'
    local prefix='%(22V.%F{$prompt_pure_colors[custom:prefix]}%22v%f .)'
    local suffix='%(23V. %F{$prompt_pure_colors[custom:suffix]}%23v%f.)'

    PROMPT= RPROMPT=
    case $preset in
        current)
            PROMPT="${jobs}${identity}${path} ${indicator}"
            RPROMPT="${env_right}${git_branch}${git_action}${git_arrows}${git_stash}${time}${node}"
            [[ -n $SSH_CONNECTION || -n $SSH_CLIENT || -n $SSH_TTY ]] && RPROMPT+=' %F{red}[SSH@%m]%f'
            ;;
        pure)
            PROMPT="${prefix}${jobs}${identity}${path}${git_branch}${git_action}${git_arrows}${git_stash}${node}${time}${suffix}"'${prompt_newline}'"${env_left}${indicator}"
            ;;
        compact)
            PROMPT="${identity}${path}${git_branch}${git_action}${git_arrows}${git_stash}${env_right} ${indicator}"
            ;;
        minimal)
            PROMPT="${path} ${indicator}"
            ;;
    esac
    typeset -g PURE_PRESET=$preset
    prompt_pure_preprompt_render
}

pure-preset() {
    emulate -L zsh
    local selected=$1
    case $selected in
        list)
            print -r -- 'current  One line; Git and environment on the right'
            print -r -- 'pure     Original two-line Pure composition'
            print -r -- 'compact  One line; Git beside the path'
            print -r -- 'minimal  Path and symbol only'
            return ;;
        current|pure|compact|minimal) ;;
        '')
            if (( ! $+commands[fzf] )) || [[ ! -t 0 || ! -t 1 ]]; then
                print -u2 -- 'Run pure-preset NAME, or pure-preset list to see choices.'
                return 1
            fi
            selected=$(print -rl -- $'current\tOne line, right-side Git and environment' $'pure\tOriginal two-line Pure' $'compact\tOne line, inline Git' $'minimal\tPath and symbol only' | fzf --delimiter=$'\t' --with-nth=1,2 --prompt='Pure preset > ')
            [[ -n $selected ]] || return 1
            selected=${selected%%$'\t'*}
            ;;
        *) print -u2 -- "Unknown Pure preset: $selected"; return 1 ;;
    esac
    pure_preset_apply "$selected" || return
    command mkdir -p -- "${PURE_PRESET_FILE:h}" || return
    print -r -- "$selected" >| "$PURE_PRESET_FILE" || return
    print -r -- "Pure preset: $selected"
}

local_pure_preset=${PURE_PRESET:-current}
[[ -r $PURE_PRESET_FILE ]] && IFS= read -r local_pure_preset < "$PURE_PRESET_FILE"
pure_preset_apply "$local_pure_preset" || pure_preset_apply current
unset local_pure_preset
