;;; monokai-dimmed-theme.el --- Dimmed Monokai, ported from VS Code -*- lexical-binding: t; -*-

;; Author: ported from VS Code Dimmed Monokai (Microsoft).
;; URL: https://github.com/microsoft/vscode/blob/main/extensions/theme-monokai-dimmed
;; Package-Requires: ((emacs "30.1"))
;; Version: 1.0.0
;; Keywords: faces, themes
;; SPDX-License-Identifier: MIT

;;; Commentary:
;;
;; Emacs port of VS Code's Dimmed Monokai
;; (extensions/theme-monokai-dimmed/themes/dimmed-monokai-color-theme.json).
;;
;; Not classic Monokai: keywords are muted, types are a dark red, functions a
;; dull orange.  Comments are not italic (upstream `fontStyle' is empty).
;; Alpha UI colours are blended onto the editor background.
;;
;;   (add-to-list 'custom-theme-load-path "/path/to/monokai-dimmed.el/")
;;   (load-theme 'monokai-dimmed t)

;;; Code:

